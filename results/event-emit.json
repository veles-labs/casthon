{
  "created": "2026-10-20T16:46:13.746686+02:00",
  "feature": "Event-facing emit function with explicit topic and encoder options",
  "api": {
    "import": "from cspr import emit",
    "default": "emit(event)",
    "explicitEncoder": "emit(event, encoder=Json.to_message)",
    "explicitTopic": "emit(event, topic=\"audit\")",
    "lowLevel": "runtime.emit_message(topic, message_payload_or_serialized_bytes)"
  },
  "behavior": [
    "emit accepts only Event instances and selects the event default unless an encoder is supplied",
    "The default topic is events; custom topics must already be registered with Casper",
    "Missing or ambiguous defaults and invalid encoder results fail before host emission",
    "Encoder callables retain the concrete event type and return MessageString or MessageBytes",
    "Encoding exceptions remain catchable and execute finally blocks",
    "CEP-18 and event contract examples use emit with event instances",
    "CEP-18 mode policy remains in its module-level emit function",
    "Low-level runtime.emit_message accepts only MessagePayload or serialized bytes",
    "Raw payload calls remain covered by low-level FFI probes and API tests",
    "The independent Wasm host fixture decodes registered message topics without hardcoded names",
    "No Contract.emit or ambient contract instance is introduced"
  ],
