  "feature": "Typed top-level Event records and explicit inherited events tuples",
  "api": {
    "eventBase": "cspr.Event",
    "declaration": "events = (Mint, Burn, ...)",
    "emit": "self.emit(Mint(recipient, amount))",
    "registry": "Contract.event_types()",
    "schemas": "cspr.events.event_schemas(...)",
    "map": "Map[Key, U8]"
  },
  "behavior": [
    "Collect declarations across the contract MRO; deduplicate identical event classes",
    "Reject distinct classes sharing a wire name and undeclared event emissions",
    "Generate CES schemas and payloads from structural CLType descriptors",
    "Freeze record constructors and field metadata without executing application source",
    "Validate event payloads before writes; retain catchable errors and uncaught-error rollback",
    "Preserve all nine upstream CEP-18 event encodings, CES schemas and native JSON fixtures"
  ],
  "recordProfile": {
    "inheritance": "single",
    "fieldDefaults": false,
    "customConstructors": false
  },
