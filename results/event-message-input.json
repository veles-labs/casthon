{
  "created": "2026-10-19T14:20:21.735763+02:00",
  "feature": "Event instances and optional encoder selection in runtime.emit_message",
  "api": {
    "default": "runtime.emit_message(topic, event)",
    "explicit": "runtime.emit_message(topic, event, encoder=Json.to_message)",
    "payload": "runtime.emit_message(topic, message_payload_or_serialized_bytes)"
  },
  "behavior": [
    "Event input uses its polymorphic to_message default unless an explicit encoder is provided",
    "Missing or ambiguous defaults raise TypeError before the host call",
    "Explicit encoders accept an event and must return MessageString or MessageBytes",
    "Encoding exceptions remain catchable and execute finally blocks before any host emission",
    "encoder is rejected for already encoded payloads and serialized bytes",
    "Generic overloads retain the concrete event type for encoder callables",
    "CEP-18 native modes pass the event and their explicit JSON encoder to runtime.emit_message",
    "No Contract.emit or ambient contract instance is introduced"
  ],
